@startuml mimari
!theme plain
skinparam backgroundColor #FFFFFF
skinparam packageStyle rectangle
skinparam roundCorner 8
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowColor #2B6CB0
skinparam ArrowThickness 1.5

header BSM 401 Bilgisayar Mühendisliği Tasarımı - Ara Rapor 2
title 3B Derin Öğrenme Tabanlı Alzheimer Karar Destek Sistemi - Mimari Blok Diyagramı (§4.1)

package "1. VERİ KATMANI (Veri Deposu & Bölme)" #EDF2F7 {
    [Ham sMRI Verisi\n(ADNI1 1.5T & OASIS-1)\n<color:#718096>NIfTI (.nii.gz) / DUA Korulamalı</color>] as DataRaw
    [Denek Bazlı Bölme Motoru\n(bolme.py)\n<color:#718096>Kilitli Dış Test & 5-Kat Tabakalı CV</color>] as DataSplit
    [Bölme Haritaları\n(veri/bolme/*_bolme_haritasi.csv)\n<color:#718096>Anonim RID / Tarama Eşleşmesi</color>] as SplitCSV
    
    DataRaw --> DataSplit
    DataSplit --> SplitCSV
}

package "2. ÖN İŞLEME KATMANI (Standartlaştırma Hattı)" #EBF8FF {
    [Format & Dönüşüm\n(dcm2niix)\n<color:#2B6CB0>DICOM -> NIfTI</color>] as PreFormat
    [Kafatası Ayıklama\n(HD-BET)\n<color:#2B6CB0>Yapay Zeka Beyin Maskeleme</color>] as PreHDBET
    [Bias Alanı Düzeltme\n(SimpleITK N4ITK)\n<color:#2B6CB0>Manyetik Alan Dengeleme</color>] as PreN4
    [Normalizasyon & Kırpma\n(Z-skor standardizasyon)\n<color:#2B6CB0>Robust Z-score [-2.5, 2.5]</color>] as PreNorm
    [Şablon Hizalama\n(SimpleITK MNI152)\n<color:#2B6CB0>1mm izotropik afin kayıtlama</color>] as PreAlign
    [Kübik Tensör Çıktısı\n(128x128x128 float16 .npy)\n<color:#2B6CB0>Standart Model Girdisi</color>] as PreTensor

    PreFormat --> PreHDBET
    PreHDBET --> PreN4
    PreN4 --> PreNorm
    PreNorm --> PreAlign
    PreAlign --> PreTensor
}

package "3. MODEL & EĞİTİM KATMANI (uygulama/)" #FEFCBF {
    [Ortak Veri Yükleyici & Artırma\n(ortak/veri.py)\n<color:#B7791F>PyTorch Dataset / 3B Rotasyon, Gürültü</color>] as Dataloader
    [Eğitim & Doğrulama Döngüsü\n(ortak/egit.py)\n<color:#B7791F>Mixed Precision (AMP), Early Stopping</color>] as TrainLoop
    
    package "6 Temel Derin Öğrenme Modeli" #FFFDF5 {
        [P01: 3D-ResNet / VoxCNN\n<color:#744210>Düz 3B CNN (Baran)</color>] as M_P01
        [P02: MedicalNet ResNet-18\n<color:#744210>3B Transfer Öğrenme (Baran)</color>] as M_P02
        [P06: 3D-CNN + LRP\n<color:#744210>Açıklanabilirlik (Görkem)</color>] as M_P06
        [P07: 3D ResAttNet + Grad-CAM\n<color:#744210>Öz-Dikkat Mekanizması (Görkem)</color>] as M_P07
        [P11: FCN-Yama + MLP\n<color:#744210>brain2020 Risk Haritası (Ertuğrul)</color>] as M_P11
        [P12: 3D DenseNet-121\n<color:#744210>Yoğun Bloklar / Tiny Varyant (Ertuğrul)</color>] as M_P12
    }
    
    [SVM & Sığ CNN Temel Çizgileri\n(ortak/svm_kos.py & model.py)\n<color:#B7791F>Voksel Düzeyi Temel Çizgi</color>] as M_Baseline

    PreTensor --> Dataloader
    SplitCSV --> Dataloader
    Dataloader --> TrainLoop
    TrainLoop --> M_P01
    TrainLoop --> M_P02
    TrainLoop --> M_P06
    TrainLoop --> M_P07
    TrainLoop --> M_P11
    TrainLoop --> M_P12
    TrainLoop --> M_Baseline
}

package "4. DOĞRULAMA & DEĞERLENDİRME KATMANI" #FEEBC8 {
    [Protokol K5 Sağlık Testleri\n(ortak/saglik_testi.py)\n<color:#C05621>Rastgele Etiket=0.5 / Ayrılabilir=1.0</color>] as ValHealth
    [Bağımsız Dış Test Motoru\n(ortak/dis_test.py)\n<color:#C05621>K4 Kontrollü / OASIS-1 Sıfır Atış</color>] as ValExternal
    [Sonuç Tablosu Üreteci\n(tablo_uret.py)\n<color:#C05621>karsilastirma/SONUCLAR.md</color>] as ValTable

    M_P01 --> ValHealth
    M_P02 --> ValHealth
    M_P06 --> ValHealth
    M_P07 --> ValHealth
    M_P11 --> ValHealth
    M_P12 --> ValHealth
    ValHealth --> ValExternal
    ValExternal --> ValTable
}

package "5. DAĞITIM & ÇIKARIM SERVİSİ KATMANI" #E6FFFA {
    [ONNX Dönüştürücü\n(onnx_disa_aktar.py)\n<color:#234E52>PyTorch -> ONNX FP32/FP16</color>] as OnnxExport
    [ONNX Runtime Motoru\n(model.onnx)\n<color:#234E52>Çerçeveden Bağımsız Yüksek Hız</color>] as OnnxEngine
    [FastAPI Servis Katmanı\n(uygulama/api/)\n<color:#234E52>POST /tahmin | GET /saglik</color>] as ApiService
    [XAI Isı Haritası Motoru\n(Grad-CAM & LRP 3B)\n<color:#234E52>NIfTI/PNG Bindirme Üreteci</color>] as XaiEngine

    ValTable --> OnnxExport : En Başarılı Model
    OnnxExport --> OnnxEngine
    OnnxEngine --> ApiService
    XaiEngine --> ApiService
}

package "6. SUNUM & VERİTABANI KATMANI" #F7FAFC {
    [Web Karar Destek Arayüzü\n(HTML5 / Modern Vanilla CSS / JS)\n<color:#4A5568>E1-E7 Ekranları (3 Dik Kesit & Rapor)</color>] as WebUI
    [İlişkisel Veritabanı\n(SQLite / PostgreSQL)\n<color:#4A5568>Kullanıcı, Tarama, Tahmin, Model DB</color>] as RelDB

    ApiService <--> WebUI : REST JSON / Multipart MRI
    ApiService --> RelDB : Meta Veri & Çıkarım Kaydı
}

@enduml
